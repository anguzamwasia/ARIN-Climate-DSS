# Copy this file to .env and fill in real values before running the backend.

ENVIRONMENT=development

DATABASE_URL=postgresql://arin:arin_secure_2026@localhost:5432/arin_dss

# Required in production (startup fails without it there). In development,
# leaving this blank generates a random per-process secret automatically.
JWT_SECRET_KEY=

OPENAI_API_KEY=your_openai_key_here
KOBO_API_TOKEN=your_kobo_token_here

# Shared secret KoboToolbox sends back on its REST Services webhook call
# (configure the same value as a custom header in the Kobo project's REST
# Services settings). Leave unset to disable the check in local dev only.
KOBO_WEBHOOK_SECRET=

# Comma-separated list of frontend origins allowed to call this API.
ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated list of emails allowed to self-register via /auth/signup.
ALLOWED_EMAILS=admin@arin-africa.org,researcher@arin-africa.org,test@example.com

# Set to false when running more than one API worker process
# (e.g. `uvicorn ... --workers 4`) and run exactly one separate process with
# RUN_SCHEDULER=true to own the scraper / Kobo-sync schedule.
RUN_SCHEDULER=true

# Toggle the chatbot's self-reinforcing "auto-learn" write-back into ChromaDB.
RAG_AUTO_LEARN=true

UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
